file = read_csv(paste0("hobos/hobos_running/", site, "_current.csv"))
p = file %>%
ggplot(aes(x = `Date-Time`, y = Temperature)) +
geom_line() +
labs(title = paste0("Temperature at ", site, " from ", min(file$`Date-Time`), " to ", max(file$`Date-Time`)))
