library(tidyverse)
library(tidyverse)
library(lubridate)
library(pracma)
library(patchwork)
cations <- read_csv("Creek and Well Cations - Sheet1.csv") %>%
mutate(
MeasurementDate = mdy(MeasurementDate),
Date = mdy(Date),
Calcium = as.numeric(Calcium), Magnesium = as.numeric(Magnesium), Potassium = as.numeric(Potassium), Sodium = as.numeric(Sodium))
anions <- read_csv("Creek and Well Anion Data - newdatasorted.csv") %>%
mutate(
MeasurementDate = mdy(MeasurementDate),
Date_full = mdy(paste(Month, Day, Year, sep = " ")),
Nitrate = as.numeric(Chloride), Flouride = as.numeric(Flouride), Chloride = as.numeric(Chloride)
)
dfs = list()
hobos_all = c("Dwnstrm", "P1", "P2", "P3", "Mdstrm", "Spring", "P4", "P5", "P5_creek_cond")
for (site in hobos_all) {
data = read_csv(paste0("hobos/hobos_running/", site, "_current.csv"))
data = data %>% drop_na()
to_filter = data$'Specific Conductivity'
result = hampel(to_filter, k = 100, t0 = 2)
final = data %>% slice(-result$ind)
dfs[[site]] = final[, c("Date-Time", "Specific Conductivity", "Temperature")]
}
df_full = bind_rows(dfs, .id = "Site") %>% drop_na()
anion_data = anions %>%
filter(PumpTest_Creek == "B", Well == "P1") %>%
# mutate(PumpTest_Creek = ifelse(PumpTest_Creek == "B", "Well", "Creek")) %>%
group_by(Date_full, PumpTest_Creek) %>%
summarize(avg = mean(Nitrate, na.rm = TRUE), .groups = "drop")
summary(anion_data)
spc_data = df_full %>%
filter(Site == "P1", `Date-Time` >= min(anion_data$Date_full), `Date-Time` <= max(anion_data$Date_full))
p1 = ggplot(spc_data, aes(x = `Date-Time`, y = `Specific Conductivity`)) +
geom_line() +
theme_bw()
p2 = ggplot(anion_data, aes(x = Date_full, y = avg)) +
geom_point() +
geom_line() +
theme_bw()
p1 / p2
