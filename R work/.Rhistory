Well == "C1" ~ "1",
Well == "C2" ~ "2",
Well == "C3" ~ "3",
Well == "C4" ~ "4",
Well == "C5" ~ "5"
),
Area = case_when(
str_sub(Well, 1, 1) == "P" ~ "Well",
