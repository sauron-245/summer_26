check_csv = function(site) { # Use this to make graphs of temperature over time. Intended to check that dates/expected data gaps are behaving as they ought.
file = read_csv(paste0("hobos/hobos_running/", site, "_current.csv"))
p = file %>%
ggplot(aes(x = `Date-Time`, y = `Specific Conductivity`)) +
geom_line() +
labs(title = paste0("Temperature at ", site, " from ", min(file$`Date-Time`), " to ", max(file$`Date-Time`)))
print(p)
}
for (hobo in hobos_week) {
check_csv(hobo)
}
p = file %>%
ggplot(aes(x = `Date-Time`, y = `Specific Conductivity`)) +
geom_line() +
geom_line(aes(y = Temperature))
labs(title = paste0("Temperature at ", site, " from ", min(file$`Date-Time`), " to ", max(file$`Date-Time`)))
p = file %>%
ggplot(aes(x = `Date-Time`, y = `Specific Conductivity`)) +
geom_line() +
geom_line(data = file, aes(y = Temperature))
p = file %>%
ggplot(aes(x = `Date-Time`, y = `Specific Conductivity`)) +
geom_line() +
geom_line(aes(x = `Date-Time`, y = Temperature))
ggplot(df_full, aes(x = `Date-Time`, y = Temperature / 1000)) +
geom_line() +
geom_line(aes((x = `Date-Time`, y = `Specific Conductivity` ))) +
ggplot(df_full, aes(x = `Date-Time`, y = Temperature / 1000)) +
geom_line() +
geom_line(aes(x = `Date-Time`, y = `Specific Conductivity` )) +
scale_y_continuous(sec.axis = sec_axis(~. * 1000))
View(df_full)
View(manual)
