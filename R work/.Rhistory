geom_line()
View(P5_cleaned)
CleanData = function(df){
data = df$height_above
result = hampel(data, k = 5, t0 = 3)
df_hampel = df %>%
filter(height_above > 0.003) %>%
slice(-result$ind)
h <- df_hampel$height_above
correction <- 0  # running correction
for (i in 2:length(h)) {
# compare original previous value + correction to original current value
diff_val <- (h[i - 1] + correction) - h[i]
if (diff_val > 0.1) {
correction <- correction + diff_val
}
df_hampel$height_above[i] <- h[i] + correction
}
df_hampel %>% data.frame()
}
P5_cleaned = CleanData(P5)
ggplot(P5_cleaned, aes(x = datetime, y = height_above)) +
geom_line()
CleanData = function(df){
CleanData = function(df){
data = df$height_above
result = hampel(data, k = 5, t0 = 3)
df_hampel = df %>%
filter(height_above > 0.003) %>%
slice(-result$ind)
h <- df_hampel$height_above
correction <- 0        # current block's correction
in_block <- FALSE      # are we currently inside an erroneous block?
for (i in 2:length(h)) {
# compute difference using original values
diff_val <- h[i - 1] - h[i]
# detect start of a new erroneous block
if (diff_val > 0.1 && !in_block) {
correction <- diff_val   # lock in the correction for this block
in_block <- TRUE
}
# detect end of erroneous block (data realigns)
if (diff_val <= 0.1 && in_block) {
correction <- 0
in_block <- FALSE
}
# apply correction if inside a block
df_hampel$height_above[i] <- h[i]
df_hampel %>% data.frame()
}
}
P5_cleaned = CleanData(P5)
