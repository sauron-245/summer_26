Location == "C1" ~ "1",
Location == "C2" ~ "2",
Location == "C3" ~ "3",
Location == "C4" ~ "4",
Location == "C5" ~ "5"
), Date = mdy_hms(Date)) %>%
filter(SPC < 1000, year(Date) > 2025)
