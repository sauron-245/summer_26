p5 = P5%>%
mutate(datetime = round_date(datetime, unit = "15 mins")) %>%
left_join(p1_baro %>% select(datetime, Pressure), by = "datetime") %>%
mutate(baro_pressure = (Pressure.y * 0.101972), height_above = (Pressure.x - baro_pressure))
p5 = P5%>%
mutate(datetime = round_date(datetime, unit = "15 mins")) %>%
