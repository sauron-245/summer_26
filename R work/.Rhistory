CleanData = function(df){
data = df$height_above
result = hampel(data, k = 5, t0 = 3)
df_hampel = df %>%
filter(height_above > 0.003)
slice(-result$ind)
for (i in seq_along(df_hampel$height_above)) {
a = df_hampel$height_above[i - 1]
b = df_hampel$height_above[i]
if (a - b > 0.1){
df_hampel$height_above[i] = df_hampel$height_above + (a-b)
}
}
}
