HampelFilter <- function (x, k,t0=3){
n <- length(x)
y <- x
ind <- c()
L <- 1.4826
for (i in (k + 1):(n – k)) {
HampelFilter <- function (x, k,t0=3){
n <- length(x)
y <- x
ind <- c()
L <- 1.4826
for (i in (k + 1):(n - k)) {
x0 <- median(x[(i - k):(i + k)])
S0 <- L * median(abs(x[(i - k):(i + k)] - x0))
if (abs(x[i] - x0) > t0 * S0) {
y[i] <- x0
ind <- c(ind, i)
}
}
list(y = y, ind = ind)
}
result = HampelFilter(test_data, k = 5)
test_data = P5$height_above %>%
drop_na()
drop_na(test_data)
drop_na(P5)
