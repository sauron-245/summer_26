geom_line(data = df_full %>% filter(Site == "P5_creek_cond" & `Date-Time` > "2026-02-03"), aes(x = `Date-Time`, y = `Specific Conductivity` / 1000), color = 'black') +
geom_point(data = manual %>% filter(Location == "P5", Date > "2026-02-03"), aes(x = Date, y = SPC / 1000)) +
