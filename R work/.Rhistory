library(tidyverse)
library(lubridate)
library(pracma)
library(scico)
library(RColorBrewer)
sites = c("Dwnstrm", "P1", "P2", "P3", "P4", "P5", "P5_creek_cond") # Default option for all HOBO monitors.
dfs = list()
level = read_csv("dtw/dtw_formatted/Bridge_formatted.csv")
manual = read_csv("manual_to_dl - Sheet1.csv") %>%
# drop_na() %>%
rename(SPC = `SPC bottom before`)
manual = manual %>%
mutate(Site = case_when(
Location == "P1" ~ "1",
Location == "P2" ~ "2",
Location == "P3" ~ "3",
Location == "P4" ~ "4",
Location == "P5" ~ "5",
Location == "C1" ~ "1",
Location == "C2" ~ "2",
Location == "C3" ~ "3",
Location == "C4" ~ "4",
Location == "C5" ~ "5"
), Date = mdy_hms(Date)) %>%
filter(SPC < 1000 & year(Date) > 2025)
for (site in sites) {
data = read_csv(paste0("hobos/hobos_running/", site, "_current.csv"))
data = data %>% drop_na()
to_filter = data$'Specific Conductivity'
result = hampel(to_filter, k = 100, t0 = 2)
final = data %>% slice(-result$ind)
dfs[[site]] = final[, c("Date-Time", "Specific Conductivity")]
}
df_full = bind_rows(dfs, .id = "Site") %>% drop_na()
View(df_full)
ggplot(df_full %>% filter(Site == "P1"), aes(x = `Date-Time`, y = SPC)) +
geom_line() +
geom_line(data = df_full %>% filter(Site == "C1"), aes(x = `Date-Time`, y = SPC))
ggplot(df_full %>% filter(Site == "P1"), aes(x = `Date-Time`, y = Specific Conductivity)) +
ggplot(df_full %>% filter(Site == "P1"), aes(x = `Date-Time`, y = `Specific Conductivity`)) +
geom_line() +
geom_line(data = df_full %>% filter(Site == "C1"), aes(x = `Date-Time`, y = `Specific Conductivity`))
ggplot() +
geom_line(df_full %>% filter(Site == "P1"), aes(x = `Date-Time`, y = `Specific Conductivity`)) +
geom_line(data = df_full %>% filter(Site == "C1"), aes(x = `Date-Time`, y = `Specific Conductivity`))
ggplot() +
geom_line(data = df_full %>% filter(Site == "P1"), aes(x = `Date-Time`, y = `Specific Conductivity`)) +
geom_line(data = df_full %>% filter(Site == "C1"), aes(x = `Date-Time`, y = `Specific Conductivity`))
df_full %>%
filter(Site == "P1" | Site == "C1") %>%
ggplot(aes(x = `Date-Time`, y = `Specific Conductivity`, color = Site)) +
geom_point()
df_full %>%
filter(Site == "P1" | Site == "C1") %>%
ggplot(aes(x = `Date-Time`, y = `Specific Conductivity`, color = Site)) +
geom_line()
df_full %>%
filter(Site == "P1" | Site == "P1_creek") %>%
ggplot(aes(x = `Date-Time`, y = `Specific Conductivity`, color = Site)) +
geom_line()
df_full %>%
filter(Site == "P1" | Site == "P1_Creek") %>%
ggplot(aes(x = `Date-Time`, y = `Specific Conductivity`, color = Site)) +
geom_line()
df_full %>%
filter(Site == "P5" | Site == "P5_creek_cond") %>%
ggplot(aes(x = `Date-Time`, y = `Specific Conductivity`, color = Site)) +
geom_line()
