scale_y_reverse() +
labs(x = "Temperature (\u00B0C)", y = "Depth proxy (m into borehole)",
color = "Time (UTC)",
title = paste0("Borehole ", BOREHOLE_NAME,
" (LAF ", BOREHOLE_LAF_MIN, "\u2013", BOREHOLE_LAF_MAX, " m)")) +
theme_bw()
