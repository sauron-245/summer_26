sizes <- drive_find(q = sprintf("'%s' in parents", FOLDER_ID), corpus = "allDrives",
fields = "files(name,size)")
# download one file, check its size, multiply by the count
tmp <- tempfile(fileext = ".xml")
drive_download(as_id(index$id[1]), path = tmp, overwrite = TRUE)
one_mb <- file.size(tmp) / 1e6
file.remove(tmp)
cat("one file:", round(one_mb, 2), "MB\n")
cat("rough total:", round(one_mb * nrow(index) / 1000, 2), "GB for", nrow(index), "files\n")
library(googledrive)
sizes <- drive_find(q = sprintf("'%s' in parents", FOLDER_ID),
corpus = "allDrives",
fields = "files(name,size)")
# download one file, measure it, scale by the total count
tmp <- tempfile(fileext = ".xml")
drive_download(as_id(index$id[1]), path = tmp, overwrite = TRUE)
one_mb <- file.size(tmp) / 1e6
file.remove(tmp)
cat("one file:", round(one_mb, 2), "MB\n")
cat("rough total:", round(one_mb * nrow(index) / 1000, 2), "GB across", nrow(index), "files\n")
n <- min(5, nrow(index))
tmp <- tempfile(fileext = ".xml")
mb <- numeric(n)
for (i in seq_len(n)) {
drive_download(as_id(index$id[i]), path = tmp, overwrite = TRUE)
mb[i] <- file.size(tmp) / 1e6
}
file.remove(tmp)
cat("avg file:", round(mean(mb), 2), "MB\n")
cat("rough total:", round(mean(mb) * nrow(index) / 1000, 2), "GB across", nrow(index), "files\n")
